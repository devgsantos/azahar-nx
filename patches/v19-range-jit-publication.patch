diff --git a/src/switch/switch_dynarmic_jit_bridge.cpp b/src/switch/switch_dynarmic_jit_bridge.cpp
--- a/src/switch/switch_dynarmic_jit_bridge.cpp
+++ b/src/switch/switch_dynarmic_jit_bridge.cpp
@@ -290,20 +290,6 @@ extern "C" bool azahar_switch_dynarmic_jit_end_write(void* opaque,
         return false;
     }
 
-    // Match libnx's CodeMemory transition exactly. The RX alias contains both
-    // executable instructions and literal data read by generated trampolines;
-    // full-buffer maintenance prevents stale data or instructions surviving
-    // from another virtual alias or an earlier mapping.
-    if (handle->jit.type == JitType_CodeMemory) {
-        const Result rc = jitTransitionToExecutable(&handle->jit);
-        if (R_FAILED(rc)) {
-            Log("jitTransitionToExecutable full flush failed rc=0x%08x size=%zu",
-                rc, handle->jit.size);
-            return false;
-        }
-        return true;
-    }
-
     const std::size_t total_size = handle->jit.size;
     offset = std::min(offset, total_size);
     size = std::min(size, total_size - offset);
@@ -311,6 +297,34 @@ extern "C" bool azahar_switch_dynarmic_jit_end_write(void* opaque,
     auto* rw = static_cast<std::uint8_t*>(handle->jit.rw_addr);
     auto* rx = static_cast<std::uint8_t*>(handle->jit.rx_addr);
 
+    if (handle->jit.type == JitType_CodeMemory) {
+        // Keep libnx's complete CodeMemory transition for prelude publication,
+        // full cache resets and explicit invalidate-all operations.
+        if (offset == 0 && size == total_size) {
+            const Result rc = jitTransitionToExecutable(&handle->jit);
+            if (R_FAILED(rc)) {
+                Log("jitTransitionToExecutable full flush failed rc=0x%08x size=%zu",
+                    rc, total_size);
+                return false;
+            }
+            return true;
+        }
+
+        if (size == 0) {
+            return true;
+        }
+
+        // Ordinary Dynarmic block emission and relinking already report the
+        // exact dirty range through Oaknut. Publish only that physical range.
+        // Clean writes through the RW alias, discard potentially stale literal
+        // data through the RX alias, then invalidate RX instructions.
+        armDCacheFlush(rw + offset, size);
+        armDCacheInvalidate(rx + offset, size);
+        armICacheInvalidate(rx + offset, size);
+        return true;
+    }
+
     if (size != 0) {
         armDCacheFlush(rw + offset, size);
     }
